{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Phones: three fixed 56px icon columns, the label column (2 tracks: 1fr + 0) takes the rest, so labels such as
     "Parfumkonzentration" stay on one line from 360px up and only break between words. */
  #{{ section.id }} .mgx-stack-grid--others {
    grid-template-columns: minmax(0, 1fr) 0 repeat(3, 56px);
    max-width: 880px;
  }
  #{{ section.id }} .mgx-stack-grid--others > div {
    hyphens: manual;
    overflow-wrap: break-word;
  }
  #{{ section.id }} .mgx-stack-grid--others > div:not(.col-span-2) {
    padding-left: 4px;
    padding-right: 4px;
  }
  #{{ section.id }} .mgx-stack-grid--others svg {
    width: 26px;
    height: 26px;
  }
  /* header row: whole words only on phones ("Designer-Parfums" breaks at its own hyphen), sized to the 56px columns */
  #{{ section.id }} .mgx-stack-grid--others > div:nth-child(-n+4) {
    hyphens: manual;
    font-size: 11px;
    line-height: 1.25;
    letter-spacing: 0;
    padding-left: 2px;
    padding-right: 2px;
  }
  @media screen and (max-width: 749px) {
    #{{ section.id }} .mgx-stack-grid--others > div:nth-child(2) > div {
      font-size: 12px;
      line-height: 1.25;
    }
    #{{ section.id }} .mgx-stack-grid--others > div.col-span-2 {
      padding-right: 10px;
    }
    #{{ section.id }} .mgx-stack-grid--others > div.col-span-2 > div:first-child {
      font-size: 13px;
      line-height: 1.3;
    }
  }
  /* very narrow phones (320px): a long compound would not fit a line, so let the browser hyphenate it properly */
  @media screen and (max-width: 359px) {
    #{{ section.id }} .mgx-stack-grid--others > div.col-span-2 > div:first-child {
      hyphens: auto;
    }
  }
  @media screen and (min-width: 750px) {
    #{{ section.id }} .mgx-stack-grid--others > div:nth-child(-n+4) {
      font-size: 16px;
      padding-left: 16px;
      padding-right: 16px;
    }
    #{{ section.id }} .mgx-stack-grid--others {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    #{{ section.id }} .mgx-stack-grid--others > div:not(.col-span-2) {
      padding-left: 16px;
      padding-right: 16px;
    }
    #{{ section.id }} .mgx-stack-grid--others svg {
      width: 40px;
      height: 40px;
    }
  }
  #{{ section.id }} .mgx-stack-note {
    margin: 12px auto 0;
    max-width: 880px;
    font-size: 12px;
    text-align: right;
    color: var(--mgx-graphite);
  }
{%- endstyle -%}

{%- liquid
  assign show_others = section.settings.show_others
  assign uses_partial = false
  if show_others
    for block in section.blocks
      if block.settings.others == 'partial'
        assign uses_partial = true
      endif
    endfor
  endif
-%}

<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">

    <h2 class="text-center text-2xl md:text-4xl font-bold max-w-2xl mx-auto mt-0">{{ section.settings.title }}</h2>
    <div class="grid gap-0 w-full max-w-3xl grid-cols-4 mx-auto{% if show_others %} mgx-stack-grid--others{% endif %}">
      <div class="col-span-2 !flex items-end border-0 border-b border-[#12121233] border-solid px-4 py-4 text-sm font-black md:text-base"></div>
      <div class="text-center rounded-t-xl border-0 border-solid border-b border-[#12121233] mgx-bg-black px-2 md:px-4 py-4">
        <div class="text-sm font-black text-white md:text-base">
          Unsere Düfte
        </div>
        <span class="[display:none] md:inline-block text-xs font-bold mgx-text-silver py-1 px-2 rounded-full bg-[#ffffff1a]">20 % Konzentration</span>
      </div>
      <div class="flex items-center justify-center rounded-t-xl border-0 border-solid border-b border-[#12121233] px-2 md:px-4 py-4 text-center text-sm font-black md:text-base [overflow-wrap:anywhere]">
        Designer-Parfums
      </div>
      {%- if show_others -%}
        <div class="flex items-center justify-center rounded-t-xl border-0 border-solid border-b border-[#12121233] px-2 md:px-4 py-4 text-center text-sm font-black md:text-base">
          {{ section.settings.others_label }}
        </div>
      {%- endif -%}
      {% for block in section.blocks %}
        {% if block.type == "stack" %}
          <div class="col-span-2 border-0 border-solid border-b border-[#12121233] pr-4 py-4">
            <div class="text-sm font-semibold text-black md:text-base">
              {{ block.settings.stack_heading }}
            </div>
            <div class="text-xs">
              {{ block.settings.stack_subheading }}
            </div>
          </div>
          <div class="flex items-center justify-center [word-break:break-word] border-0 border-solid border-b border-[#12121233] mgx-bg-black text-white px-4 py-4 text-sm tracking-normal md:text-base ">
            <svg role="img" aria-label="Ja" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" fill="var(--mgx-amber)"/>
              <path d="M16.0303 8.96967C16.3232 9.26256 16.3232 9.73744 16.0303 10.0303L11.0303 15.0303C10.7374 15.3232 10.2626 15.3232 9.96967 15.0303L7.96967 13.0303C7.67678 12.7374 7.67678 12.2626 7.96967 11.9697C8.26256 11.6768 8.73744 11.6768 9.03033 11.9697L10.5 13.4393L12.7348 11.2045L14.9697 8.96967C15.2626 8.67678 15.7374 8.67678 16.0303 8.96967Z" fill="#ffffff"/>
            </svg>
          </div>
          <div class="flex items-center justify-center [word-break:break-word] border-0 border-solid border-b border-[#12121233] p-4 py-4 text-sm tracking-normal md:text-base">
            <svg role="img" aria-label="Nein" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g stroke="var(--mgx-graphite)" stroke-width="2">
                <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z"/>
                <path stroke-linecap="round" d="M9 15L15 9M15 15L9 9"/>
              </g>
            </svg>
          </div>
          {%- if show_others -%}
            <div class="flex items-center justify-center border-0 border-solid border-b border-[#12121233] p-4 py-4">
              {%- case block.settings.others -%}
                {%- when 'yes' -%}
                  <svg role="img" aria-label="Ja" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g stroke="var(--mgx-graphite)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z"/>
                      <path d="M8 12.2L10.6 14.8L16 9.4"/>
                    </g>
                  </svg>
                {%- when 'no' -%}
                  <svg role="img" aria-label="Nein" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g stroke="var(--mgx-graphite)" stroke-width="2">
                      <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z"/>
                      <path stroke-linecap="round" d="M9 15L15 9M15 15L9 9"/>
                    </g>
                  </svg>
                {%- else -%}
                  <svg role="img" aria-label="Je nach Marke" width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g stroke="var(--mgx-graphite)" stroke-width="2" stroke-linecap="round">
                      <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z"/>
                      <path d="M8.5 12H15.5"/>
                    </g>
                  </svg>
              {%- endcase -%}
            </div>
          {%- endif -%}
        {% endif %}
      {% endfor %}
      <div class="col-span-2 !block"></div>
      <div class="rounded-b-xl mgx-bg-black px-4 py-4 !block"></div>
      <div class="!block"></div>
      {%- if show_others -%}<div class="!block"></div>{%- endif -%}
    </div>
    {%- if uses_partial and section.settings.partial_note != blank -%}
      <p class="mgx-stack-note">{{ section.settings.partial_note }}</p>
    {%- endif -%}
    <div class="max-w-[400px] mx-auto mt-8 flex flex-col gap-6 items-center">
      <a
        href="{{ section.settings.btn_url }}"
        class="no-underline mgx-btn-primary tracking-normal font-medium px-8 py-3 rounded-full text-lg text-center transition-colors w-full block tabs-cta-ripple-animation"
        aria-label="Alle anzeigen">
        {{ section.settings.btn_text }}
      </a>
      <ul class="flex justify-center flex-wrap gap-x-6 gap-y-3 list-unstyled">
        <li class="flex items-center gap-1.5">
          <img
            src="{{ 'sandwatch.svg' | asset_url }}"
            height="16"
            width="auto"
            alt="Icon">
          <span class="leading-none">20 % Parfumöl*</span>
        </li>

        <li class="flex items-center gap-1.5">
          <img
            src="{{ 'icon-heart.svg' | asset_url }}"
            height="16"
            width="auto"
            alt="Icon">
          <span class="leading-none">Hergestellt in der EU
          </span>
        </li>

        <li class="flex items-center gap-1.5">
          <img
            src="{{ 'sheild-star.svg' | asset_url }}"
            height="16"
            width="auto"
            alt="Icon">
          <span class="leading-none">60 Tage Rückgaberecht*</span>
        </li>

      </ul>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Stacks Up",
    "tag": "section",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Wie MagicPerfume im Vergleich zur Konkurrenz abschneidet"
      },
      {
        "type": "checkbox",
        "id": "show_others",
        "label": "Show 'other dupes' column",
        "default": true
      },
      {
        "type": "text",
        "id": "others_label",
        "label": "Other dupes column: heading",
        "default": "Andere Dupes"
      },
      {
        "type": "text",
        "id": "partial_note",
        "label": "Note under the table",
        "info": "Shown when a row uses 'Varies by brand'. Empty = no note.",
        "default": "⊖ = je nach Marke unterschiedlich"
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text",
        "default": "Alle anzeigen"
      },
      {
        "type": "url",
        "id": "btn_url",
        "label": "Button URL",
        "default": "/collections/all"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "stack",
        "name": "Stack",
        "settings": [
          {
            "type": "text",
            "id": "stack_heading",
            "label": "Stack Heading",
            "default": "Haltbarkeit"
          }, {
            "type": "text",
            "id": "stack_subheading",
            "label": "Stack Subheading",
            "default": "12+ Stunden"
          }, {
            "type": "select",
            "id": "others",
            "label": "Other dupes",
            "options": [
              { "value": "yes", "label": "Yes" },
              { "value": "partial", "label": "Varies by brand" },
              { "value": "no", "label": "No" }
            ],
            "default": "partial"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Stacks Up"
      }
    ]
  }
{% endschema %}