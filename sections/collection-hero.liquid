{{ 'collection-description.css' | asset_url | stylesheet_tag }}
{%- assign hero_mobile_image = collection.metafields.custom.hero_mobile_image -%}
{%- assign hero_desktop_image = collection.image -%}
<div class="relative flex h-auto min-h-[520px] items-end bg-[#eef1f3] bg-[image:var(--hero-img-mobile)] bg-cover bg-[position:50%_10%] bg-no-repeat pb-[34px] sm:h-[clamp(430px,33.33vw,600px)] sm:min-h-0 sm:items-center sm:bg-[image:var(--hero-img-desktop)] sm:bg-[position:50%_3%] sm:pb-0" style="{% if hero_mobile_image %}--hero-img-mobile: url('{{ hero_mobile_image | image_url: width: 750 }}');{% endif %} {% if hero_desktop_image %}--hero-img-desktop: url('{{ hero_desktop_image | image_url: width: 1920 }}');{% endif %}">
  <div class="!block absolute inset-0 bg-[linear-gradient(180deg,rgba(246,247,248,0)_38%,rgba(246,247,248,.82)_58%,rgba(246,247,248,.97)_74%,#f6f7f8_100%)] sm:bg-[linear-gradient(90deg,rgba(248,248,247,.97)_0%,rgba(248,248,247,.93)_30%,rgba(248,248,247,.72)_46%,rgba(248,248,247,0)_68%)]"></div>
  <div class="page-width relative z-[1] w-full">
    <div class="md:w-1/2 {%  if hero_mobile_image != blank %} pt-80 md:pt-0 {% endif %}">
      {% if section.settings.show_rating_badge %}
        <p class="mb-[10px] flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.16em] mgx-text-accent">
          <span class="tracking-[0.06em]">★★★★★</span>
          {{ section.settings.rating_text }}
        </p>
      {% endif %}
      <h1 class="mb-3 whitespace-nowrap text-[clamp(28px,2.8vw,44px)] font-normal leading-[1.1] tracking-[-0.015em] text-[#14181c]" style="font-family: Georgia, 'Times New Roman', serif;">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        {%- comment -%}
          Folded to the first two sentences (theessencevault.co.uk pattern, ported from magyx.co): the script below
          runs as the page is parsed, before the first paint, so the full text never flashes up. Without JavaScript
          the whole description shows and the toggle stays hidden. A <div>, not a <p>: the description itself is
          made of <p> blocks. Left-aligned and sized like the rest of this hero.
        {%- endcomment -%}
        <div
          class="mgx-cdesc rte max-w-[400px] text-[clamp(15px,1.05vw,17px)] leading-[1.5] text-[#14181c]"
          data-mgx-cdesc
        >
          <div class="mgx-cdesc__text" id="MgxCollectionDescription-{{ section.id }}">{{ collection.description }}</div>
          <button
            type="button"
            class="mgx-cdesc__toggle"
            aria-expanded="false"
            aria-controls="MgxCollectionDescription-{{ section.id }}"
            data-more="+ {{ section.settings.description_more_label | escape }}"
            data-less="- {{ section.settings.description_less_label | escape }}"
            hidden
          >
            + {{ section.settings.description_more_label | escape }}
          </button>
        </div>
        <script>
          (function () {
            // Shows the first two sentences of the description; the rest (the remainder of that paragraph and every
            // block after it) gets [hidden] until the toggle opens it. A sentence ends at . ! or ? followed by a space
            // and a capital, a quote, a bracket or a digit, or at the end of a paragraph. Not an end: "No." before a
            // number, and the German abbreviations Nr., z. B., z.B., ca., inkl., bzw., u. a., usw., d. h.
            var SHOWN = 2;
            var ABBR = /(?:^|[^a-zÀ-Ž])(?:nr|ca|inkl|bzw|usw|z\.\s?b|u\.\s?a|d\.\s?h)\.$/i;
            var PAIR = /(?:^|[^a-zÀ-Ž])(?:z\.\s?b|u\.\s?a|d\.\s?h)\./i;
            var setup = function (root) {
              if (!root || root.dataset.mgxReady) return;
              root.dataset.mgxReady = '1';
              var text = root.querySelector('.mgx-cdesc__text');
              var toggle = root.querySelector('.mgx-cdesc__toggle');
              if (!text || !toggle) return;
              var blocks = [];
              var loose = false;
              for (var n = text.firstChild; n; n = n.nextSibling) {
                if (n.nodeType === 1) blocks.push(n);
                else if (n.nodeType === 3 && n.nodeValue.trim()) loose = true;
              }
              if (loose || !blocks.length) blocks = [text];
              var ends = function (str) {
                var out = [];
                var re = /[.!?]+["'”’)]*(?=\s+["'“‘„(]?[A-Z0-9À-Ž])/g;
                var m;
                while ((m = re.exec(str))) {
                  var before = str.slice(0, m.index + 1);
                  var after = str.slice(re.lastIndex);
                  if (/\bno\.$/i.test(before) && /^\s+\d/.test(after)) continue;
                  // "z." of "z. B." (and u. a. / d. h.) is not an end either: check the dot with its partner.
                  if (ABBR.test(before) || PAIR.test(before.slice(-3) + after.slice(0, 4))) continue;
                  out.push(re.lastIndex);
                }
                var trimmed = str.replace(/\s+$/, '');
                if (/[.!?]["'”’)]*$/.test(trimmed) && out[out.length - 1] !== trimmed.length) out.push(trimmed.length);
                return out;
              };
              var count = 0;
              var cutBlock = -1;
              var cutAt = -1;
              for (var i = 0; i < blocks.length && cutBlock < 0; i++) {
                var str = blocks[i].textContent;
                var e = ends(str);
                if (count + e.length >= SHOWN) {
                  cutBlock = i;
                  cutAt = e[SHOWN - count - 1];
                }
                count += e.length;
              }
              if (cutBlock < 0) return;
              var hide = [];
              var block = blocks[cutBlock];
              var rest = block.textContent.slice(cutAt);
              if (rest.trim()) {
                // The second sentence ends inside a paragraph: move the rest of that paragraph into a hidden span.
                var walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
                var seen = 0;
                var node;
                while ((node = walker.nextNode())) {
                  if (seen + node.nodeValue.length >= cutAt) break;
                  seen += node.nodeValue.length;
                }
                if (!node) return;
                var range = document.createRange();
                range.setStart(node, cutAt - seen);
                range.setEnd(block, block.childNodes.length);
                var span = document.createElement('span');
                span.className = 'mgx-cdesc__rest';
                span.appendChild(range.extractContents());
                block.appendChild(span);
                hide.push(span);
              }
              for (var j = cutBlock + 1; j < blocks.length; j++) {
                if (blocks[j] !== text && blocks[j].textContent.trim()) hide.push(blocks[j]);
              }
              if (!hide.length) return;
              if (block !== text) block.classList.add('mgx-cdesc__cut');
              hide.forEach(function (el) {
                el.hidden = true;
              });
              toggle.hidden = false;
              toggle.addEventListener('click', function () {
                var open = toggle.getAttribute('aria-expanded') !== 'true';
                toggle.setAttribute('aria-expanded', String(open));
                toggle.textContent = open ? toggle.dataset.less : toggle.dataset.more;
                root.classList.toggle('is-open', open);
                hide.forEach(function (el) {
                  el.hidden = !open;
                });
              });
            };
            var scripts = document.getElementsByTagName('script');
            var me = document.currentScript || scripts[scripts.length - 1];
            setup(me && me.previousElementSibling);
            if (!window.mgxCdescHeroEditor) {
              window.mgxCdescHeroEditor = true;
              document.addEventListener('shopify:section:load', function (event) {
                event.target.querySelectorAll('[data-mgx-cdesc]').forEach(setup);
              });
            }
          })();
        </script>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Collection Hero",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_rating_badge",
        "label": "Show rating badge",
        "default": true
      }, {
        "type": "text",
        "id": "rating_text",
        "label": "Rating badge text",
        "default": "Sprawdzone przez ponad 10 000 miłośników zapachów"
      }, {
        "type": "text",
        "id": "description_more_label",
        "label": "Description: show more",
        "default": "Weiterlesen",
        "info": "The description shows its first two sentences; this opens the rest"
      }, {
        "type": "text",
        "id": "description_less_label",
        "label": "Description: show less",
        "default": "Weniger anzeigen"
      }
    ],
    "presets": [
      {
        "name": "Collection Hero"
      }
    ]
  }
{% endschema %}