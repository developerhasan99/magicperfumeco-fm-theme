{%- comment -%}
  gg-bundle-builder: "Selbst zusammenstellen" builder of the Gift Guide. Visual layer only: the discount is the store's
  own automatic quantity discount (Shopify applies it at cart and checkout), the builder just shows it.
  Layout: top = product card (image | "Dein Set" box: bottles in cart, discount steps, saving, gift packaging,
  "Zum Warenkorb", trust row), below = filters (ready-made gift sets, gender, scent family, search) + scent card
  grid with infinite scroll, plus a sticky bar (count, %, saving, next step) while the builder is on screen.
  Cart (assets/gg-builder.js): a tap on a scent adds its 50 ml variant to the cart as a normal line, − removes one.
  Ready-made sets go in as their own line (GG.bundleItem: "Flasche N" + _bundle_items), they never count toward the
  quantity discount. Gift packaging = its own line, toggled from the box.
  Discount steps (setting "2:25,4:30,6:35,8:40") must mirror the automatic discounts in Shopify; counted bottles =
  cart lines of products in the discount collections (setting) or lines Shopify already discounted, minus set lines,
  free gifts and the packaging. Saving = what Shopify actually took off those lines (cart.js), never estimated.
  Gift cards elsewhere on the page call GG.preset(ids) -> window 'gg:preset' -> those scents pin to the top of the grid.
{%- endcomment -%}
{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gg-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gg-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings

  # Discount steps "min:percent" pairs, sorted as typed
  assign bb_steps_json = ''
  assign bb_steps = st.discount_steps | default: '2:25,4:30,6:35,8:40' | split: ','
  assign bb_first_min = 0
  assign bb_first_pct = 0
  for s in bb_steps
    assign sp = s | strip | split: ':'
    assign s_min = sp[0] | plus: 0
    assign s_pct = sp[1] | plus: 0
    if s_min < 1 or s_pct < 1
      continue
    endif
    if bb_steps_json != ''
      assign bb_steps_json = bb_steps_json | append: ','
    else
      assign bb_first_min = s_min
      assign bb_first_pct = s_pct
    endif
    assign bb_steps_json = bb_steps_json | append: '{"min":' | append: s_min | append: ',"pct":' | append: s_pct | append: '}'
  endfor

  # Pool collection: setting, else best-sellers, else all products
  assign bb_coll = st.pool_collection
  if bb_coll == blank
    assign bb_coll = collections['best-sellers']
  endif
  if bb_coll == blank
    assign bb_coll = collections.all
  endif
  assign bb_limit = st.pool_limit | default: 200 | plus: 0
  assign bb_size_tok = st.bottle_size | default: '50ml' | strip | downcase | remove: ' '
  assign bb_word = st.inspired_word | default: 'Inspiriert von'
  assign bb_anchor = st.anchor | default: 'selbst-zusammenstellen' | handleize
  assign bb_img = st.image
  if bb_img == blank and st.image_product != blank
    assign bb_img = st.image_product.featured_image
  endif

  # Gift packaging: first "gift_wrap" block with a product (e.g. the hidden "Geschenkverpackung")
  assign bb_wrap = blank
  assign bb_wrap_block = blank
  for block in section.blocks
    if block.type == 'gift_wrap' and block.settings.product != blank
      assign bb_wrap = block.settings.product.selected_or_first_available_variant
      assign bb_wrap_block = block
      break
    endif
  endfor

  assign bb_status0 = 'Ab [n] Düften sparst du [pct]%' | replace: '[n]', bb_first_min | replace: '[pct]', bb_first_pct
-%}

<div class="gg gg--surface-2 gg-bb" id="gg-{{ section.id }}">
  <span class="gg-anchor" id="{{ bb_anchor }}">&#8203;</span>
  <div class="gg__wrap">
    <div class="gg-head">
      {%- if st.eyebrow != blank -%}<span class="gg-eyebrow">{{ st.eyebrow | escape }}</span>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="gg-h2">{{ st.heading | escape }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<p class="gg-sub">{{ st.text | escape }}</p>{%- endif -%}
    </div>

    <gg-builder class="gg-bb__card" data-section="{{ section.id }}">
      <script type="application/json" data-gg-config>
        {
          "steps": [{{ bb_steps_json }}],
          "bottleLabel": {{ st.bottle_label | default: 'Flasche' | json }},
          "pageSize": 12,
          "cartUrl": {{ routes.cart_url | json }},
          "wrap": {%- if bb_wrap != blank -%}{"variantId":"{{ bb_wrap.id }}","price":{{ bb_wrap.price }},"available":{{ bb_wrap.available }}}{%- else -%}null{%- endif -%},
          "qualify": [
            {%- assign bb_q_n = 0 -%}
            {%- assign bb_q_handles = st.discount_collections | default: 'best-sellers,fuer-maenner,black-utique' | split: ',' -%}
            {%- for h in bb_q_handles -%}
              {%- assign qh = h | strip -%}
              {%- assign qc = collections[qh] -%}
              {%- if qc == blank -%}{%- continue -%}{%- endif -%}
              {%- paginate qc.products by 250 -%}
                {%- for qp in qc.products -%}
                  {%- if bb_q_n > 0 -%},{%- endif -%}{{ qp.id }}
                  {%- assign bb_q_n = bb_q_n | plus: 1 -%}
                {%- endfor -%}
              {%- endpaginate -%}
            {%- endfor -%}
          ],
          "t": {
            "number": "Nr. [n]",
            "inspired": {{ bb_word | json }},
            "count": {{ st.count_label | default: '[n] Düfte' | json }},
            "add": {{ st.add_label | default: 'Hinzufügen' | json }},
            "isNew": {{ st.new_badge | default: 'Neu' | json }},
            "best": {{ st.best_badge | default: 'Bestseller' | json }},
            "inCart": "[n] Düfte im Warenkorb",
            "inCartOne": "1 Duft im Warenkorb",
            "start": "Ab [n] Düften sparst du [pct]%",
            "toFirst": "Noch [n] Duft bis [pct]% Rabatt",
            "toFirstMany": "Noch [n] Düfte bis [pct]% Rabatt",
            "toNext": "Noch [n] Duft bis [pct]%",
            "toNextMany": "Noch [n] Düfte bis [pct]%",
            "top": "Höchster Rabatt erreicht",
            "save": "Du sparst [amount]",
            "remove": "Entfernen",
            "error": {{ st.error | default: 'Das hat nicht geklappt. Bitte versuch es noch einmal.' | json }},
            "none": {{ st.no_results | default: 'Kein Duft gefunden.' | json }},
            "showMore": {{ st.show_more | default: '[n] Düfte mehr zeigen' | json }}
          }
        }
      </script>
      <script type="application/json" data-gg-pool>
        [
        {%- comment -%}
          Pool = the main collection (bottle_size, max pool_limit, sorted by best-selling) + the extra collections
          (pool_extra "handle:size", e.g. black-utique:100ml), appended after it. A product in two collections shows once.
          Extra collections have no "Nr." in their titles: the card shows the name before " - " and the collection title under it.
        {%- endcomment -%}
        {%- assign bb_count = 0 -%}
        {%- assign bb_seen = ',' -%}
        {%- assign bb_entries = bb_coll.handle | append: ':' | append: bb_size_tok -%}
        {%- if st.pool_extra != blank -%}{%- assign bb_entries = bb_entries | append: ',' | append: st.pool_extra -%}{%- endif -%}
        {%- assign bb_entries = bb_entries | split: ',' -%}
        {%- for bb_e in bb_entries -%}
          {%- assign bb_ep = bb_e | strip | split: ':' -%}
          {%- assign bb_h = bb_ep[0] | strip -%}
          {%- assign bb_pc = collections[bb_h] -%}
          {%- if bb_h == blank or bb_pc == blank -%}{%- continue -%}{%- endif -%}
          {%- assign bb_main = forloop.first -%}
          {%- assign bb_tok = bb_ep[1] | default: bb_size_tok | strip | downcase | remove: ' ' -%}
        {%- paginate bb_pc.products by 250 -%}
          {%- for p in bb_pc.products -%}
            {%- if bb_main and bb_count >= bb_limit -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign skip = false
              if p.available == false or p.tags contains 'bundle' or p.has_only_default_variant
                assign skip = true
              endif
              assign p_key = ',' | append: p.id | append: ','
              if bb_seen contains p_key
                assign skip = true
              endif
              assign v = blank
              unless skip
                for pv in p.variants
                  assign pv_size = pv.title | downcase | remove: ' '
                  assign pv_head = pv_size | slice: 0, bb_tok.size
                  if pv.available and pv_head == bb_tok
                    assign v = pv
                    break
                  endif
                endfor
                if v == blank
                  assign skip = true
                endif
              endunless
            -%}
            {%- unless skip -%}
              {%- liquid
                assign p_w = false
                if p.tags contains 'Woman' or p.tags contains 'Women' or p.tags contains 'woman' or p.tags contains 'women' or p.tags contains 'Für Frauen' or p.tags contains 'fuer-frauen' or p.tags contains 'FÜR FRAUEN' or p.tags contains 'Frauen'
                  assign p_w = true
                endif
                assign p_m = false
                if p.tags contains 'Man' or p.tags contains 'Men' or p.tags contains 'man' or p.tags contains 'men' or p.tags contains 'Für Männer' or p.tags contains 'fuer-maenner' or p.tags contains 'FÜR MÄNNER'
                  assign p_m = true
                endif
                assign p_g = ''
                if p.tags contains 'unisex' or p.tags contains 'Unisex' or p.tags contains 'UNISEX'
                  assign p_g = 'unisex'
                elsif p_w and p_m
                  assign p_g = 'unisex'
                elsif p_w
                  assign p_g = 'female'
                elsif p_m
                  assign p_g = 'male'
                endif

                # Bestseller badge = the first 20 scents of the pool (Adrian 11.11: "only top 20"). The pool
                # collection is sorted by best-selling, so its order is Shopify's sales rank.
                assign p_best = false
                if bb_main and bb_count < 20
                  assign p_best = true
                endif
                assign p_new = false
                for t in p.tags
                  assign t_low = t | downcase | strip
                  if t_low == 'new' or t_low == 'neu' or t_low == 'new-arrival'
                    assign p_new = true
                  endif
                endfor

                assign p_fam = ''
                assign mf = p.metafields.custom.fragrance_family
                if mf != blank
                  if mf.type contains 'list.'
                    assign p_fam = mf.value | join: ', '
                  else
                    assign p_fam = mf.value | strip
                  endif
                endif
              -%}
              {%- capture bb_meta -%}{% render 'gg-scent-meta', product: p, variant: v, inspired_word: bb_word %}{%- endcapture -%}
              {%- assign bb_m = bb_meta | split: '~|~' -%}
              {%- liquid
                assign bb_n = bb_m[0] | default: '' | strip
                assign bb_t = p.title
                assign bb_s = ''
                unless bb_main
                  assign bb_n = ''
                  assign bb_t = p.title | split: ' - ' | first | strip
                  assign bb_s = bb_pc.title
                endunless
                assign bb_seen = bb_seen | append: p.id | append: ','
              -%}
              {%- if bb_count > 0 -%},{%- endif -%}
              {"v":"{{ v.id }}","pid":{{ p.id }},"n":{{ bb_n | json }},"t":{{ bb_t | json }},"s":{{ bb_s | json }},"i":{{ bb_m[1] | default: '' | strip | json }},"o":{{ bb_m[2] | default: '' | strip | json }},"f":{{ p_fam | json }},"g":"{{ p_g }}","b":{{ p_best }},"w":{{ p_new }},"p":{{ v.price }},"img":{%- if p.featured_image != blank -%}{{ p.featured_image | image_url: width: 400 | json }}{%- else -%}""{%- endif -%},"c":{{ bb_m[4] | default: p.title | strip | json }}}
              {%- assign bb_count = bb_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endpaginate -%}
        {%- endfor -%}
        ]
      </script>

      <div class="gg-bb__top">
        <div class="gg-bb__media">
          {%- if bb_img != blank -%}
            {{ bb_img | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', class: 'gg-bb__img', alt: bb_img.alt }}
          {%- elsif request.design_mode -%}
            <span class="gg-bb__img gg-bb__img--empty"></span>
          {%- endif -%}
        </div>

        <div class="gg-bb__sum" data-sum>
          <div class="gg-bb__sum-line">
            <span class="gg-bb__sum-title">{{ st.set_title | default: 'Dein Set' | escape }}</span>
            <span class="gg-bb__of" data-of>0 Düfte im Warenkorb</span>
          </div>

          {%- comment -%} Discount steps: one marker per step, the bar fills up to the bottles in the cart. Same markup again in the sticky bar. {%- endcomment -%}
          {%- capture bb_steps_html -%}
          <div class="gg-bb__steps" data-steps>
            <div class="gg-bb__steps-bar"><span class="gg-bb__steps-fill" data-steps-fill></span></div>
            <ol class="gg-bb__steps-list">
              {%- for s in bb_steps -%}
                {%- assign sp = s | strip | split: ':' -%}
                {%- assign s_min = sp[0] | plus: 0 -%}
                {%- assign s_pct = sp[1] | plus: 0 -%}
                {%- if s_min < 1 or s_pct < 1 -%}{%- continue -%}{%- endif -%}
                <li class="gg-bb__step-mark" data-step-min="{{ s_min }}">
                  <strong>-{{ s_pct }}%</strong>
                  <span>{{ s_min }} Düfte</span>
                </li>
              {%- endfor -%}
            </ol>
          </div>
          {%- endcapture -%}
          {{ bb_steps_html }}

          <p class="gg-bb__status" data-status aria-live="polite">{{ bb_status0 | escape }}</p>
          <p class="gg-bb__saving" data-saving hidden></p>

          <div class="gg-bb__picked" role="list" data-picked hidden></div>
          <div class="gg-bb__addons" role="list" data-addons hidden></div>

          {%- if bb_wrap != blank and bb_wrap.available -%}
            <label class="gg-bb__wrap" {{ bb_wrap_block.shopify_attributes }}>
              <input class="gg-bb__wrap-input" type="checkbox" data-wrap>
              <span class="gg-bb__wrap-switch" aria-hidden="true"></span>
              <span class="gg-bb__wrap-txt">
                <a class="gg-bb__wrap-title" href="{{ bb_wrap_block.settings.product.url }}" target="_blank" rel="noopener">{{ bb_wrap_block.settings.label | default: 'Als Geschenk verpacken' | escape }}</a>
                {%- if bb_wrap_block.settings.text != blank -%}
                  <span class="gg-bb__wrap-sub">{{ bb_wrap_block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
              <span class="gg-bb__wrap-price">+{{ bb_wrap.price | money_without_trailing_zeros }}</span>
            </label>
          {%- endif -%}

          <button type="button" class="gg-btn gg-btn--primary gg-btn--block gg-bb__cta" data-cta disabled>{{ st.cta | default: 'Zum Warenkorb' | escape }}</button>
          <p class="gg-bb__err" role="alert" data-err hidden></p>
          {%- if st.fine_print != blank -%}<p class="gg-bb__fine">{{ st.fine_print | escape }}</p>{%- endif -%}
          {%- comment -%} Same trust pair as the store's other buy boxes (pm-bundle-save, quantity-breaker) {%- endcomment -%}
          <div class="gg-bb__trust">
            {% render 'mgx-payment-icons' %}
            {% render 'shipping-badges' %}
          </div>
        </div>
      </div>

      <div class="gg-bb__pick">
        <div class="gg-bb__filters">
          {%- capture bb_chips -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'preset' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign pp = block.settings.product
                assign pp_ids = ''
                if pp != blank
                  for fv in pp.metafields.custom.fixed_bundle_products.value
                    if fv.id != blank
                      if pp_ids != ''
                        assign pp_ids = pp_ids | append: ','
                      endif
                      assign pp_ids = pp_ids | append: '"' | append: fv.id | append: '"'
                    endif
                  endfor
                endif
                assign pp_label = block.settings.label
                if pp_label == blank and pp != blank
                  assign pp_label = pp.metafields.custom.gift_title.value | default: pp.title
                endif
                assign pp_v = blank
                if pp != blank
                  assign pp_v = pp.selected_or_first_available_variant
                endif
              -%}
              {%- if pp_ids != '' and pp_v != blank and pp_v.available -%}
                {%- comment -%} Fair value = the set's 50 ml bottles at their single prices (bought separately) {%- endcomment -%}
                {%- assign pp_fair = 0 -%}
                {%- for fv in pp.metafields.custom.fixed_bundle_products.value -%}
                  {%- assign pp_fair = pp_fair | plus: fv.price -%}
                {%- endfor -%}
                {%- if pp_fair <= pp_v.price -%}{%- assign pp_fair = 0 -%}{%- endif -%}
                {%- capture pp_names -%}
                  [
                  {%- for fv in pp.metafields.custom.fixed_bundle_products.value -%}
                    {%- capture pp_meta -%}{% render 'gg-scent-meta', product: fv.product, variant: fv, inspired_word: bb_word %}{%- endcapture -%}
                    {%- assign pp_m = pp_meta | split: '~|~' -%}
                    {"id":{{ fv.id | json }},"name":{{ pp_m[4] | default: fv.product.title | strip | json }}}{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                  ]
                {%- endcapture -%}
                <button type="button" class="gg-bb__chip" data-set-variant="{{ pp_v.id }}" data-set-price="{{ pp_v.price }}" data-set-compare="{{ pp_fair }}" data-set-title="{{ pp_label | escape }}" data-set-scents="{{ pp_names | strip | escape }}" aria-pressed="false" {{ block.shopify_attributes }}><span class="gg-bb__chip-ok" aria-hidden="true">✓</span><span>{{ pp_label | escape }}</span><span class="gg-bb__chip-price">+{{ pp_v.price | money_without_trailing_zeros }}{%- if pp_fair > 0 -%}{{ ' ' }}<s>{{ pp_fair | money_without_trailing_zeros }}</s>{%- endif -%}</span></button>
              {%- elsif request.design_mode -%}
                <button type="button" class="gg-bb__chip" disabled {{ block.shopify_attributes }}>{{ pp_label | default: 'Geschenkset wählen' | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if bb_chips != blank -%}
            <div class="gg-bb__group gg-bb__group--presets">
              <p class="gg-bb__label" id="ggbb-pre-{{ section.id }}">{{ st.presets_label | escape }}</p>
              <div class="gg-bb__scroller gg-bb__chips" role="group" aria-labelledby="ggbb-pre-{{ section.id }}">
                {{- bb_chips -}}
              </div>
              {%- if st.presets_note != blank -%}<p class="gg-bb__note">{{ st.presets_note | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}

          <div class="gg-bb__group" data-g-group>
            <p class="gg-bb__label" id="ggbb-g-{{ section.id }}">{{ st.gender_label | escape }}</p>
            <div class="gg-bb__scroller gg-bb__opts" role="group" aria-labelledby="ggbb-g-{{ section.id }}">
              <button type="button" class="gg-bb__opt is-active" data-g="all" aria-pressed="true"><span>{{ st.gender_all | escape }}</span> <span class="gg-bb__cnt" data-cnt="all"></span></button>
              <button type="button" class="gg-bb__opt" data-g="unisex" aria-pressed="false"><span>{{ st.gender_unisex | escape }}</span> <span class="gg-bb__cnt" data-cnt="unisex"></span></button>
              <button type="button" class="gg-bb__opt" data-g="male" aria-pressed="false"><span>{{ st.gender_male | escape }}</span> <span class="gg-bb__cnt" data-cnt="male"></span></button>
              <button type="button" class="gg-bb__opt" data-g="female" aria-pressed="false"><span>{{ st.gender_female | escape }}</span> <span class="gg-bb__cnt" data-cnt="female"></span></button>
            </div>
          </div>

          <div class="gg-bb__group" data-f-group>
            <p class="gg-bb__label" id="ggbb-f-{{ section.id }}">{{ st.family_label | escape }}</p>
            <div class="gg-bb__scroller gg-bb__pills" role="group" aria-labelledby="ggbb-f-{{ section.id }}" data-f-list>
              <button type="button" class="gg-bb__pill is-active" data-f="" aria-pressed="true">{{ st.gender_all | escape }}</button>
            </div>
          </div>

          <div class="gg-bb__group gg-bb__group--search">
            <label class="gg-vh" for="ggbb-q-{{ section.id }}">{{ st.search_placeholder | escape }}</label>
            <div class="gg-bb__search">
              <svg class="gg-bb__search-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <input class="gg-bb__input" type="search" id="ggbb-q-{{ section.id }}" placeholder="{{ st.search_placeholder | escape }}" autocomplete="off" data-q>
            </div>
          </div>
        </div>

        <div class="gg-bb__main">
          <div class="gg-bb__listhead">
            <p class="gg-bb__count" data-count aria-live="polite"></p>
            <p class="gg-bb__sort">{{ st.sort_label | escape }}</p>
          </div>
          <div class="gg-bb__list" role="list" data-list tabindex="-1"></div>
          <button type="button" class="gg-btn gg-bb__more" data-more hidden></button>
        </div>
      </div>

      {%- comment -%} Sticky bar: shown while the builder is on screen and the box is not {%- endcomment -%}
      <div class="gg-bb__bar" data-bar hidden>
        <div class="gg-bb__bar-in">
          <div class="gg-bb__bar-steps">{{ bb_steps_html }}</div>
          <button type="button" class="gg-bb__bar-cart" data-bar-cta aria-label="{{ st.cta | default: 'Zum Warenkorb' | escape }}" disabled>
            {%- render 'icon-cart' -%}
            <span class="gg-bb__bar-badge" data-bar-badge hidden>0</span>
          </button>
        </div>
      </div>
    </gg-builder>
  </div>
</div>

{% schema %}
{
  "name": "GG Set-Builder",
  "tag": "section",
  "class": "gg-section pm-scope",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker (ohne #)", "default": "selbst-zusammenstellen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selbst zusammenstellen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Stell dein eigenes Set zusammen" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Bild links" },
    { "type": "product", "id": "image_product", "label": "Bild von Produkt", "info": "Wird genutzt, wenn kein Bild gewählt ist." },
    { "type": "header", "content": "Mengenrabatt" },
    { "type": "paragraph", "content": "Der Rabatt kommt aus den automatischen Rabatten in Shopify. Hier nur die Anzeige: Stufen und Kollektionen müssen zu den Rabatten passen." },
    { "type": "text", "id": "discount_steps", "label": "Stufen (Anzahl:Prozent)", "default": "2:25,4:30,6:35,8:40" },
    { "type": "text", "id": "discount_collections", "label": "Rabatt-Kollektionen (Handles)", "default": "best-sellers,fuer-maenner,black-utique" },
    { "type": "header", "content": "Duftauswahl" },
    { "type": "collection", "id": "pool_collection", "label": "Kollektion", "info": "Leer: best-sellers, dann alle Produkte." },
