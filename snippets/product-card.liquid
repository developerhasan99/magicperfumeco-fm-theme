{%- comment -%} Site product card, Black Friday look (styles: assets/magyx-brand.css, "product card"). {%- endcomment -%}
<div class="mgx-card flex flex-col bg-white p-4 shadow-sm rounded-lg relative h-full">
  <a href="{{ product.url }}" class="mgx-card__media">
    <img
      src="{{ product.images.first | image_url: width: 600 }}"
      alt="{{ product.title }}"
      height="{{ product.images.first.height }}"
      width="{{ product.images.first.width }}"
      loading="lazy"
    >
    {% if product.tags contains 'bestseller' %}
      <span class="mgx-card__badge">Bestseller</span>
    {% elsif product.tags contains 'onsale' %}
      <span class="mgx-card__badge mgx-card__badge--sale">Angebot</span>
    {% endif %}
    {% unless product.tags contains 'Bundle_Price_Show' %}
      <div class="card__promo-marquee" aria-label="Black Friday: 40 % Rabatt + 2 Flakons gratis dazu!">
        <div class="card__promo-marquee-rail">
          <div class="card__promo-marquee-group">
            <span class="card__promo-marquee-text">Black Friday: 40 % Rabatt + 2 Flakons gratis dazu!</span>
            <span class="card__promo-marquee-dot" aria-hidden="true"></span>
          </div>
          <div class="card__promo-marquee-group" aria-hidden="true">
            <span class="card__promo-marquee-text">Black Friday: 40 % Rabatt + 2 Flakons gratis dazu!</span>
            <span class="card__promo-marquee-dot" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    {% endunless %}
  </a>

  {% comment %} <div class="flex items-center flex-wrap gap-x-2 gap-y-1 mt-3">
    {% if product.tags contains 'onsale' %}
      <div class="mgx-badge-amber-soft text-xs font-semibold px-2 py-1 rounded inline-block">
        Sale
      </div>
    {% endif %}

    {% if product.metafields.custom.custom_label != blank %}
      <div class="mgx-badge-amber-soft text-xs font-semibold px-2 py-1 rounded inline-block custom_label">
        {{ product.metafields.custom.custom_label }}
      </div>
    {% endif %}

    {%- if show_rating and product.metafields.reviews.rating.value != blank -%}
      {% liquid
        assign rating_decimal = 0
        assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
        if decimal >= 0.3 and decimal <= 0.7
          assign rating_decimal = 0.5
        elsif decimal > 0.7
          assign rating_decimal = 1
        endif
      %}
      <div>
        <div
        class="rating"
        role="img"
        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
      >
        <img src="{{ 'rating-stars.svg' | asset_url }}" alt="*****" height="13" width="66">
      </div>
      <p class="rating-text caption">
        <span aria-hidden="true">
          {{- product.metafields.reviews.rating.value }} /
          {{ product.metafields.reviews.rating.value.scale_max -}}
        </span>
      </p>
      <p class="rating-count caption">
        <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
        <span class="visually-hidden">
          {{- product.metafields.reviews.rating_count }}
          {{ 'accessibility.total_reviews' | t -}}
        </span>
      </p>
      </div>
    {%- endif -%}
  </div> {% endcomment %}

  <h3 class="mgx-card__title">
    <a href="{{ product.url }}">
      {{ product.title }}
    </a>
  </h3>

  {% if product.metafields.custom.inspiration != blank %}
    <div class="mgx-card__insp">
      <span class="mgx-card__thumb">
        <img
          src="{{ product.metafields.custom.inspiration.value.image | image_url: width: 120 }}"
          alt="{{ product.metafields.custom.inspiration.value.image.alt | escape }}"
          width="44"
          height="44"
          loading="lazy"
        >
      </span>
      <div>
        <p class="mgx-card__insp-label">Inspiriert von:</p>
        <h4 class="text-sm font-semibold my-0 line-clamp-1 inspiration_heading">{{ product.metafields.custom.inspiration.value.name }}</h4>
      </div>
    </div>
  {% endif %}

  <div class="my-3">
    {%- render 'price',
      product: product,
      use_variant: true,
      show_badges: false,
      price_class: 'price--large'
    -%}
  </div>

  <div class="mt-auto">
    <a class="mgx-card__btn" href="{{ product.url }}">
      Duft ansehen
    </a>
  </div>
</div>