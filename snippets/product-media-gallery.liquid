{% if product == blank %}
  {% assign product = product_param %}
{% endif %}

{% liquid
  # Products tagged 'own_gallery' show only their own images, no marketing images
  unless product.tags contains 'own_gallery'
    assign de_marketing_images = shop.metaobjects['marketing_images']['german'].images.value
  endunless
%}

<div class="sticky top-6 !mt-0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <div class="flex -mx-[15px] md:mx-0">
    <div id="productSwiper" class="swiper ">
      <div class="swiper-wrapper">
        {% if product.tags contains "local_image" %}
          {% assign image_found = false %}
          {% for image in product.images %}
            {% assign curr_currency = localization.country.iso_code | prepend: "bundle_" | downcase %}
            {% assign img_alt = image.alt | downcase %}
            {% if img_alt contains "bundle_" and img_alt == curr_currency %}
              {% assign image_found = true %}
              <img
                src="{{ image.src | img_url: 'master' }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="productSwiperImage swiper-slide md:rounded-lg">
            {% endif %}
          {% endfor %}
          {% if image_found == false %}
            {% for image in product.images %}
              {% assign img_alt = image.alt | downcase %}
              {% if img_alt contains "bundle_usd" %}
                <img
                  src="{{ image.src | img_url: 'master' }}"
                  alt="{{ image.alt }}"
                  height="{{ image.height }}"
                  width="{{ image.width }}"
                  class="productSwiperImage swiper-slide md:rounded-lg">
              {% endif %}
            {% endfor %}
          {% endif %}
          {% if de_marketing_images != blank %}
            {% for image in de_marketing_images %}
              <img
                src="{{ image.src | image_url: width: 1080 }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="productSwiperImage swiper-slide md:rounded-lg marketing_image">
            {% endfor %}
          {% endif %}
        {% else %}
          {% for image in product.images limit: 1 %}
            <img
              src="{{ image.src | img_url: 'master' }}"
              alt="{{ image.alt }}"
              height="{{ image.height }}"
              width="{{ image.width }}"
              class="productSwiperImage swiper-slide md:rounded-lg">
          {% endfor %}
          {% if de_marketing_images != blank %}
            {% for image in de_marketing_images %}
              <img
                src="{{ image.src | image_url: width: 1080 }}"
                alt="{{ image.alt }}"
                height="{{ image.height }}"
                width="{{ image.width }}"
                class="productSwiperImage swiper-slide md:rounded-lg marketing_image">
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
      <div
        data-text="text"
        id="productSwiperPrev"
        class="swiper-button-prev rounded-full !flex bg-white !size-10 [&]:after:!text-xl [&]:after:text-gray-900"></div>
      <div
        data-text="text"
        id="productSwiperNext"
        class="swiper-button-next rounded-full !flex bg-white !size-10 [&]:after:!text-xl [&]:after:text-gray-900"></div>
    </div>
  </div>
  <div>
    <div id="productThumbnails" class="swiper mt-4">
      <div class="swiper-wrapper mgx-thumbs [&>.swiper-slide-thumb-active]:opacity-100">
        {% if product.tags contains "local_image" %}
          {% assign image_found = false %}
          {% for image in product.images %}
            {% assign curr_currency = localization.country.iso_code | prepend: "bundle_" | downcase %}
            {% assign img_alt = image.alt | downcase %}
            {% if img_alt contains "bundle_" and img_alt == curr_currency %}
              {% assign image_found = true %}
              <img
                id="slider-thumbnail-{{ forloop.index0 }}"
                src="{{ image | image_url: width: 150, height: 150 }}"
                alt="{{ image.alt }}"
                height="150"
                width="150"
                class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid border-gray-200 rounded-lg cursor-pointer" />
            {% endif %}
          {% endfor %}
          {% if image_found == false %}
            {% for image in product.images %}
              {% assign img_alt = image.alt | downcase %}
              {% if img_alt contains "bundle_usd" %}
                <img
                  id="slider-thumbnail-{{ forloop.index0 }}"
                  src="{{ image | image_url: width: 150, height: 150 }}"
                  alt="{{ image.alt }}"
                  height="150"
                  width="150"
                  class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid border-gray-200 rounded-lg cursor-pointer" />
              {% endif %}
            {% endfor %}
          {% endif %}
          {% if de_marketing_images != blank %}
            {% for image in de_marketing_images %}
              <img
                id="slider-thumbnail-{{ forloop.index0 }}"
                src="{{ image | image_url: width: 150, height: 150 }}"
                alt="{{ image.alt }}"
                height="150"
                width="150"
                class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid border-gray-200 rounded-lg cursor-pointer marketing_image" />
            {% endfor %}
          {% endif %}
        {% else %}
          {% for image in product.images limit: 1 %}
            <img
              id="slider-thumbnail-{{ forloop.index0 }}"
              src="{{ image | image_url: width: 150, height: 150 }}"
              alt="{{ image.alt }}"
              height="150"
              width="150"
              class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid border-gray-200 rounded-lg cursor-pointer" />
          {% endfor %}
          {% if de_marketing_images != blank %}
            {% for image in de_marketing_images %}
              <img
                id="slider-thumbnail-{{ forloop.index0 }}"
                src="{{ image | image_url: width: 150, height: 150 }}"
                alt="{{ image.alt }}"
                height="150"
                width="150"
                class="productThumbnail swiper-slide slide max-w-16 md:max-w-24 opacity-70 border-2 border-solid border-gray-200 rounded-lg cursor-pointer marketing_image" />
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <script>
      // Swiper Slider For product images with thumbnail sync
      window.addEventListener("DOMContentLoaded", function () {
    var productThumbnails = new Swiper('#productThumbnails', {
      slidesPerView: 5,
      spaceBetween: 8,
      freeMode: true,
      watchSlidesProgress: true,
      watchOverflow: true,
      direction: 'horizontal',
      slideToClickedSlide: true,
      breakpoints: {
        320: {
          slidesPerView: 4,
        },
        600: {
          slidesPerView: 4,
        },
        900: {
          slidesPerView: 5,
        }
      }
    });

    var productImages = new Swiper('#productSwiper', {
      slidesPerView: 1,
      spaceBetween: 10,
      observer: true,
      observeParents: true,
      navigation: {
        prevEl: "#productSwiperPrev",
        nextEl: "#productSwiperNext",
      },
      thumbs: {
        swiper: productThumbnails
      },
      breakpoints: {
        320: {
          slidesPerView: 1,
          spaceBetween: 10,
        },
        600: {
          slidesPerView: 1,
          spaceBetween: 20,
        },
        800: {
          slidesPerView: 1,
          spaceBetween: 20,
        },
      },
    });
      });
  </script>
</div>