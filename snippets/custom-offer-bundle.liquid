{%- comment -%}
  Top of the bundle buy box, laid out like magyx.co: short description + "Vollständige Beschreibung" (opens and
  scrolls to the "Beschreibung" tab further down), then struck regular price, price, red -N% badge,
  price per bottle and the "Du sparst ... heute" pill.
{%- endcomment -%}
{% if product.metafields.custom.bundle_product_content != blank %}
  <div class="mgx-bundle-desc">
    <p class="text-black text-sm md:text-base leading-normal tracking-normal m-0">{{ product.metafields.custom.bundle_product_content }}</p>
    <a
      href="#mgx-bundle-description"
      data-mgx-open-description
      class="inline-block mt-2 text-xs font-bold tracking-wider uppercase text-gray-900 underline underline-offset-4 decoration-2 mgx-underline-hover cursor-pointer">Vollständige Beschreibung</a>
  </div>
  <script>
    (function () {
      var link = document.currentScript.previousElementSibling.querySelector('[data-mgx-open-description]');
      link.addEventListener('click', function (event) {
        var tab = Array.prototype.find.call(document.querySelectorAll('.product__accordion details'), function (d) {
          var title = d.querySelector('.accordion__title');
          return title && /beschreibung/i.test(title.textContent);
        });
        if (!tab) return;
        event.preventDefault();
        tab.open = true;
        var header = document.querySelector('sticky-header, .section-header');
        var offset = header && getComputedStyle(header).position.indexOf('sticky') > -1 ? header.offsetHeight : 0;
        window.scrollTo({ top: tab.getBoundingClientRect().top + window.scrollY - offset - 12, behavior: 'smooth' });
      });
    })();
  </script>
{% endif %}

<div class="mb-3">{% render 'mgx-claims' %}</div>

{% if product.metafields.custom.bundle_size != blank %}
  <div
    id="price-{{ section.id }}"
    class="bundle-price-pdp"
    role="status"
    {{ block.shopify_attributes }}>
    <div class="flex flex-wrap items-center gap-x-3">
      {% if product.compare_at_price > product.price %}
        <span class="text-gray-500 font-semibold line-through mgx-bundle-compare compare-price">
          {{ product.compare_at_price | money }}
        </span>
      {% endif %}
      <span class="text-black font-bold mgx-bundle-price product-price">
        {{ product.price | money }}
      </span>
      {% if product.compare_at_price > product.price %}
        {% assign discount = product.compare_at_price | minus: product.price %}
        {% assign discount_percent = discount | times: 100 | divided_by: product.compare_at_price | round %}
        <span class="mgx-badge-sale font-bold px-2 text-xs md:text-base discount-percent">
          -{{ discount_percent }}%
        </span>
      {% endif %}
    </div>
    <div class="text-lg font-semibold text-black leading-normal">
      Das entspricht nur {{ product.price | divided_by: product.metafields.custom.bundle_size | money }} pro Flasche
    </div>
    {% if product.compare_at_price > product.price %}
      {% assign you_save = product.compare_at_price | minus: product.price %}
      <div class="inline-flex items-center gap-1 mt-2 mgx-badge-sale-soft font-bold text-sm rounded-full py-1 px-2 border border-solid mgx-border-sale">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z"></path></svg>
        Du sparst heute {{ you_save | money }}
      </div>
    {% endif %}
  </div>
{% endif %}

{% assign bundle_collection_handles = 'best-sellers,new' | split: ',' %}
{% assign product_count = product.metafields.custom.bundle_size %}
{% assign dropdown_ml = product.metafields.custom.select_bundle_dropdown_ml | default: "50" %}
{% assign bundle_ml = dropdown_ml | append: "ml" %}
{% assign bundle_size_token = dropdown_ml | append: '' | downcase | strip | replace: ' ', '' | remove: 'ml' | append: 'ml' %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign fixed_bundle_products = product.metafields.custom.fixed_bundle_products.value %}

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

{%- liquid
  assign next_bundle = product.metafields.custom.next_bundle
  if next_bundle != blank
    assign next_bundle_product = next_bundle.value
    assign next_size = next_bundle_product.metafields.custom.select_bundle_dropdown_ml
    assign price_difference = next_bundle_product.price | minus: product.price | money
  endif
-%}

{% if next_bundle != blank %}
  <div class="bg-white border border-gray-200 rounded-lg px-4 py-2.5 mb-4">
    <div class="flex items-center gap-2 text-black">
      <svg
        class="size-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
      </svg>
      <span>Upgrade auf
        <a href="{{ next_bundle_product.url }}" class="ml-auto font-medium mgx-text-accent whitespace-nowrap transition-colors">
          {{ next_size }} ml für {{ price_difference }} mehr.</a>
      </span>
    </div>
  </div>
{% endif %}

<div x-data>
  <div class="grid grid-cols-1 gap-2 mb-4">
    <template x-for="index in ({{ product_count }})" :key="index">
      <div
        {% unless product.tags contains 'fixed_bundle' %}
          @click="$store.bundleBuilder.showModal = true"
        {% endunless %}
        class="bg-white border-2 border-solid border-gray-200 flex items-center p-[7px] rounded-xl gap-2 cursor-pointer relative transition duration-300 mgx-hover-selected"
        :class="{ 'mgx-selected-strong' : typeof $store.bundleBuilder.selectedProducts[index - 1] !== 'undefined'}">
        <div x-text="index" class="mgx-bg-black size-6 rounded-lg text-white font-bold text-xs flex items-center justify-center shrink-0"></div>
        <div x-show="!$store.bundleBuilder.selectedProducts[index - 1]" class="flex min-w-0 gap-2 items-center flex-grow">
            {% render 'perfume-icon'
            , size: 40 %}
            <div class="min-w-0 flex-1">
              <div class="text-sm text-[#6b7280] overflow-hidden whitespace-nowrap [text-overflow:ellipsis]">
                Wähle deinen Duft
              </div>
            </div>
            <span class="ml-auto shrink-0 text-[#6b7280]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg></span>
        </div>
        <div x-show="$store.bundleBuilder.selectedProducts[index - 1]" class="flex min-w-0 gap-2 items-center flex-grow">
            <img
                class="object-cover rounded"
                :src="$store.bundleBuilder.selectedProducts[index - 1].image"
                :alt="$store.bundleBuilder.selectedProducts[index - 1].name"
                width="40"
                height="40"
            >
            <div class="text-left min-w-0 flex-1 flex flex-col gap-1">
                <div class="font-bold text-sm leading-tight text-black line-clamp-1" x-text="$store.bundleBuilder.selectedProducts[index - 1].name"></div>
                <div class="text-xs line-clamp-1 text-[#6b7280]"><span x-text="$store.bundleBuilder.selectedProducts[index - 1].inspiration_name"></span> - <span x-text="$store.bundleBuilder.selectedProducts[index - 1].variant.title"></span></div>
            </div>
            {% unless product.tags contains 'fixed_bundle' %}
              <button @click.stop.prevent="$store.bundleBuilder.removeProduct(index - 1)" class="ml-auto size-7 shrink-0 bg-red-50 flex items-center justify-center rounded text-xs cursor-pointer border-0">
                  {% render 'icon-trash' %}
              </button>
            {% else %}
            {% endunless %}
        </div>
      </div>
    </template>
  </div>

  <button
    x-data
    @click="$store.bundleBuilder.doATCandCheckout()"
    :disabled="$store.bundleBuilder.selectedProducts.length < {{ product_count }} || $store.bundleBuilder.addingToCart"
    :class="{
        'opacity-50 cursor-not-allowed': $store.bundleBuilder.selectedProducts.length < {{ product_count }},
        'cursor-pointer': $store.bundleBuilder.selectedProducts.length >= {{ product_count }}
      }"
    class="w-full flex gap-2 flex-wrap items-center !mb-0 text-lg font-bold !py-3 !px-2 rounded-full button mgx-btn-primary transition-colors shadow-xl tracking-normal button--full-width"
  >
    <span x-show="$store.bundleBuilder.selectedProducts.length < {{ product_count }}" x-text="'Wähle noch ' + ({{ product_count }} - $store.bundleBuilder.selectedProducts.length) + ' aus'"></span>
    <span x-show="$store.bundleBuilder.selectedProducts.length === {{ product_count }}">Jetzt kaufen</span>
    <span class="size-2 rounded-full inline-block bg-white/50"></span>
    <span class="current-price">{{ selected_variant.price | money }}</span>
    <div x-show="$store.bundleBuilder.addingToCart" class="loading__spinner">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="spinner"
        viewBox="0 0 66 66">
        <circle
          stroke-width="6"
          cx="33"
          cy="33"
          r="30"
          fill="none"
          class="path"></circle>
      </svg>
    </div>
  </button>
  <p x-data x-show="$store.bundleBuilder.cartError" x-text="$store.bundleBuilder.cartError"
     role="alert" aria-live="assertive" class="!mt-2 !mb-0 text-sm text-center text-red-600"></p>
</div>

{%- comment -%} Under the buy button, the same trio as the scent PDPs (snippets/reactive-atc.liquid): FUEL_06 finder link, payment icons, badge row. The finder link shows only on templates listed in the fuel06_pdp_templates theme setting (custom-bundle added 10.11.2026). {%- endcomment -%}
{%- render 'fuel06-pdp-link' -%}

<div>
  {% render 'mgx-payment-icons' %}
</div>

{% render 'shipping-badges' %}

<script>
  document.addEventListener('alpine:init', function() {
    Alpine.store('bundleBuilder', {
      selectedVariant: {{ bundle_size_token | json }},
      bundleLength: {{ product_count }},
      showModal: false,
      activeCategory: "All",
      searchText: "",
      addingToCart: false,
      cartError: '',
      selectedProducts: [
        {% if product.tags contains 'fixed_bundle' %}
          {% for fixed_var in fixed_bundle_products %}
            {
              id: {{ fixed_var.product.id }},
              name: "{{ fixed_var.product.title }}",
              image: "{{ fixed_var.product.featured_image | image_url }}",
              inspiration_name: "{% if fixed_var.product.metafields.custom.inspiration.value %}{{ fixed_var.product.metafields.custom.inspiration.value.name }}{% endif %}",
              variant: {
                id: "{{ fixed_var.id }}",
                title: "{{ fixed_var.title }}"
              }
            },
          {% endfor %}
        {% endif %}
      ],
      availableProducts: [
        {% for bundle_collection_handle in bundle_collection_handles %}
          {% assign bundle_collection = collections[bundle_collection_handle] %}
          {% if bundle_collection_handle == 'new' and bundle_collection == blank %}
            {% assign bundle_collection = collections['neue-dufte'] %}
          {% endif %}
          {% paginate bundle_collection.products by 250 %}
            {% for bundle_product in bundle_collection.products %}
              {% liquid
                assign bundle_variant = nil
                for variant in bundle_product.variants
                  assign variant_token = variant.title | downcase | strip | replace: ' ', ''
                  if variant_token == bundle_size_token
                    assign bundle_variant = variant
                    break
                  endif
                endfor
                if bundle_variant == blank or bundle_variant.available == false
                  continue
                endif
                if bundle_variant.inventory_management == 'shopify' and bundle_variant.inventory_quantity < 1
                  continue
                endif

                assign collection_handles = ''
                for collection in bundle_product.collections
                  assign collection_handles = collection_handles | append: collection.handle
                  if forloop.last == false
                    assign collection_handles = collection_handles | append: ','
                  endif
                endfor
              %}
              {
                id: {{ bundle_product.id }},
                name: {{ bundle_product.title | json }},
                image: "{{ bundle_product.featured_image | image_url: width: 120, height: 120 }}",
                nuta: {{ bundle_product.metafields.custom.inspiration.value.name | default: '' | json }},
                inspiration_image: "{% if bundle_product.metafields.custom.inspiration.value %}{{ bundle_product.metafields.custom.inspiration.value.image | image_url: width: 90, height: 90 }}{% endif %}",
                inspiration_name: {{ bundle_product.metafields.custom.inspiration.value.name | default: '' | json }},
                occasion: "{{ bundle_product.metafields.custom.occasion | escape }}",
                tags: {{ bundle_product.tags | json }},
                collections: "{{ collection_handles }}",
                isNewArrival: {% if bundle_collection_handle == 'new' %}true{% else %}false{% endif %},
                variants: {
                  {{ bundle_size_token | json }}: {
                    title: {{ bundle_variant.title | json }},
                    id: "{{ bundle_variant.id }}"
                  }
                }
              },
            {% endfor %}
          {% endpaginate %}
        {% endfor %}
      ].reduce((products, product) => {
        const existing = products.find(item => item.id === product.id);
        if (existing) {
          existing.isNewArrival = existing.isNewArrival || product.isNewArrival;
        } else {
          products.push(product);
        }
        return products;
      }, []),
      productInCollection(product, handle) {
        return (product.collections || '').split(',').includes(handle);
      },
      matchesProduct(product) {
        const categoryMatches = this.activeCategory === 'All'
          || (this.activeCategory === 'new' ? product.isNewArrival : this.productInCollection(product, this.activeCategory));
        const search = this.searchText.trim().toLowerCase();
        return categoryMatches && (product.name.toLowerCase().includes(search)
          || (product.inspiration_name || '').toLowerCase().includes(search));
      },
      addRemoveProduct(product) {
        if (this.selectedProducts.length >= {{ product_count }}) return;
        product.variant = product.variants[this.selectedVariant];
        this.selectedProducts.push(product);

        if (this.selectedProducts.length === {{ product_count }}) {
          this.showModal = false;
          {%- if block.settings.skip_atc_button %}
          // Do auto ATC
          this.doATCandCheckout();
          {%- endif %}
        }
      },
      removeOne(productId) {
        const index = this.selectedProducts.map(item => item.id).lastIndexOf(productId);
        if (index > -1) this.removeProduct(index);
      },
      countOf(productId) {
        return this.selectedProducts.filter(item => item.id === productId).length;
      },
      removeProduct(index) {
        this.selectedProducts.splice(index, 1);
      },
      isProductSelected(productId) {
        return this.selectedProducts.some(product => product.id === productId);
      },
      doATCandCheckout() {
        // Set loading state
        this.addingToCart = true;
        this.cartError = '';

        // Products added from elsewhere (e.g. a quiz prefill) may not have a variant yet
        this.selectedProducts.forEach(product => {
          product.variant = product.variant || product.variants[this.selectedVariant];
        });

        // Create properties object with bundle items
        const properties = {
          "_bundle_items": this.selectedProducts.map(product => 
            product.variant.id
          ).join(',')
        };
        // Add each selected product as a separate property
        this.selectedProducts.forEach((product, index) => {
          properties[`Flasche ${index + 1}`] =
            `${product.name} Inspiriert von ${product.inspiration_name} - ${product.variant.title}`;
        });
        // Prepare cart items
        const items = {
          items: [{
            id: {{ selected_variant.id }},
            quantity: 1,
            properties: properties
          }]
        };
        // Ask for the cart drawer sections so it can re-render without a reload
        const cart = document.querySelector('cart-drawer');
        if (cart) {
          items.sections = cart.getSectionsToRender().map(s => s.id);
          items.sections_url = window.location.pathname;
        }

        // Make the API call
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(items),
        })
        .then(async response => {
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data.status) {
            const error = new Error(data.description || data.message || `Request failed with status ${response.status}`);
            error.response = data;
            throw error;
          }
          return data;
        })
        .then(data => {
          {%- unless product.tags contains 'fixed_bundle' %}
          this.selectedProducts = [];
          {%- endunless %}
          {%- if block.settings.open_checkout %}
          window.location.href = '/checkout';
          {%- else %}
          if (cart) {
            cart.renderContents(data);
          } else {
            window.location.href = '/cart';
          }
          {%- endif %}
        })
        .catch(error => {
          console.error('Error adding to cart:', error, error.response || '');
          const response = error.response || {};
          this.cartError = response.description || response.message || {{ 'sections.cart.cart_error' | t | json }};
        })
        .finally(() => {
          this.addingToCart = false;
        });
      }
    });
  });
</script>

<div class="my-6">
  <div class="flex items-center gap-3 text-base">
    <img
      src="https://cdn.shopify.com/s/files/1/0623/0691/0402/files/thimbs_up.png?v=1751372431"
      alt="Thumbs up badge"
      class="w-10 h-10 flex-shrink-0"
      width="40"
      height="40" />
    <div class="mgx-text">
      <strong class="font-semibold">Teste es 60 Tage lang – völlig risikofrei.</strong>
      <div class="[display:none] md:block">Solltest du nicht absolut begeistert sein, erstatten wir dir den vollen Betrag zurück!</div>
    </div>
  </div>
</div>