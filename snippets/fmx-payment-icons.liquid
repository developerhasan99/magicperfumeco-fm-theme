{%- comment -%}
  fmx-payment-icons (magicperfume.co): payment methods row under the buy button on the FM product pages
  (payday builder, scent pages, bundle pages). Same fixed list as snippets/mgx-payment-icons.liquid (live):
  PayPal, Klarna, SEPA-Lastschrift, eps, Apple Pay, Google Pay, Visa, Mastercard; in the FM layout of
  tryscent.co snippets/fmx-payment-icons.liquid (one centred line). An icon Shopify cannot draw is left
  out instead of printing an error.

  Usage:
  {% render 'fmx-payment-icons' %}
{%- endcomment -%}
{%- assign fmx_pay_types = 'paypal,klarna,sepadirectdebit,eps,apple_pay,google_pay,visa,master' | split: ',' -%}
<style>
  .fmx-pay-icons { display: flex; justify-content: center; gap: 6px; max-width: 400px; margin: 32px auto 0; padding: 0; list-style: none; }
  .fmx-pay-icons > li { flex: 0 1 38px; min-width: 0; margin: 0; }
  .fmx-pay-icons__icon { display: block; width: 100%; height: auto; }
</style>
<ul class="fmx-pay-icons" role="list" aria-label="Zahlungsmethoden">
  {%- for type in fmx_pay_types -%}
    {%- capture fmx_pay_icon -%}{{ type | strip | payment_type_svg_tag: class: 'fmx-pay-icons__icon' | replace: '>SEPA Direct Debit<', '>SEPA-Lastschrift<' }}{%- endcapture -%}
    {%- if fmx_pay_icon contains '<svg' -%}
      <li>{{ fmx_pay_icon }}</li>
    {%- endif -%}
  {%- endfor -%}
</ul>
