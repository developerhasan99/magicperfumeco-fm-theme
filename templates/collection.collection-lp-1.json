mal gesetzt hat: wow.</p>\n        <p class=\"mp-result\">Das Warten wert.</p>\n        <div class=\"mp-card-foot\"><strong>Lionel M.</strong></div>\n      </article>\n    </div>\n    <div class=\"mp-nav\">\n      <button type=\"button\" class=\"mp-arrow\" data-mp-prev aria-label=\"Vorherige Rezension\">&#8249;</button>\n      <div class=\"mp-dots\" data-mp-dots></div>\n      <button type=\"button\" class=\"mp-arrow\" data-mp-next aria-label=\"N&#228;chste Rezension\">&#8250;</button>\n    </div>\n  </div>\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('mp-reviews-custom');\n  if (!root) return;\n  var track = root.querySelector('[data-mp-carousel]');\n  var cards = Array.prototype.slice.call(track.children);\n  var dotsWrap = root.querySelector('[data-mp-dots]');\n  var prev = root.querySelector('[data-mp-prev]');\n  var next = root.querySelector('[data-mp-next]');\n  if (!cards.length) return;\n\n  function step(){ return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }\n  function positions(){ return Math.max(1, cards.length - Math.round(track.clientWidth / step()) + 1); }\n  function current(){\n    var max = track.scrollWidth - track.clientWidth;\n    if (track.scrollLeft >= max - 2) return positions() - 1;\n    return Math.round(track.scrollLeft / step());\n  }\n  function go(i){ track.scrollTo({left: i * step(), behavior: 'smooth'}); }\n\n  function buildDots(){\n    dotsWrap.innerHTML = '';\n    for (var i = 0; i < positions(); i++) {\n      var d = document.createElement('button');\n      d.type = 'button';\n      d.className = 'mp-dot';\n      d.setAttribute('aria-label', 'Rezension ' + (i + 1));\n      d.addEventListener('click', go.bind(null, i));\n      dotsWrap.appendChild(d);\n    }\n    update();\n  }\n  function update(){\n    var c = current(), n = positions();\n    Array.prototype.forEach.call(dotsWrap.children, function(d, i){ d.classList.toggle('active', i === c); });\n    prev.disabled = c <= 0;\n    next.disabled = c >= n - 1;\n  }\n\n  prev.addEventListener('click', function(){ go(Math.max(0, current() - 1)); });\n  next.addEventListener('click', function(){ go(Math.min(positions() - 1, current() + 1)); });\n  var t;\n  track.addEventListener('scroll', function(){ clearTimeout(t); t = setTimeout(update, 60); });\n  window.addEventListener('resize', buildDots);\n  buildDots();\n})();\n</script>",
