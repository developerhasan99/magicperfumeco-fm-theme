n#mp-reviews-custom .mp-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px}\n#mp-reviews-custom .mp-arrow{width:40px;height:40px;border-radius:50%;border:1px solid #d6d6d6;background:#fff;color:#100F0D;font-size:22px;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 3px;transition:background .2s,color .2s,border-color .2s}\n#mp-reviews-custom .mp-arrow:hover{background:#100F0D;border-color:#100F0D;color:#fff}\n#mp-reviews-custom .mp-arrow:disabled{opacity:.35;cursor:default;background:#fff;color:#100F0D;border-color:#d6d6d6}\n#mp-reviews-custom .mp-dots{display:flex;gap:0}\n#mp-reviews-custom .mp-dot{box-sizing:content-box;width:8px;height:8px;border-radius:50%;border:0;padding:8px 5px;background:#d9d9d9;background-clip:content-box;cursor:pointer}\n#mp-reviews-custom .mp-dot.active{background:#00b67a}\n@media(max-width:749px){\n  #mp-reviews-custom{padding:32px 0}\n  #mp-reviews-custom .mp-container{width:100%}\n  #mp-reviews-custom .mp-head{padding:0 18px;margin-bottom:22px}\n  #mp-reviews-custom .mp-stars-lg span{width:24px;height:24px}\n  #mp-reviews-custom .mp-title{font-size:22px}\n  #mp-reviews-custom .mp-carousel{gap:12px;padding:4px 18px 8px;scroll-padding-left:18px}\n  #mp-reviews-custom .mp-card{flex-basis:82%}\n  #mp-reviews-custom .mp-arrow{display:none}\n}\n</style>\n\n<section id=\"mp-reviews-custom\">\n  <div class=\"mp-container\">\n    <div class=\"mp-head\">\n      <div class=\"mp-stars-lg\" role=\"img\" aria-label=\"5 von 5 Sternen\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg 